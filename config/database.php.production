<?php
/**
 * KMF Website - Database connection (MySQL)
 * Production Environment Configuration (cPanel Hosting)
 * 
 * Instructions:
 * 1. Copy this file to 'config/database.php' on your cPanel server.
 * 2. Update the credentials below to match your cPanel MySQL settings.
 */

// In cPanel setups, DB_HOST is usually 'localhost' or '127.0.0.1'.
define('DB_HOST', 'localhost');

// IMPORTANT: In cPanel, your database name and database user are automatically prefixed
// with your cPanel username followed by an underscore (e.g. if your cPanel login is 'mykmf',
// then database name might be 'mykmf_kmf_website' and user might be 'mykmf_kmf_user').
define('DB_NAME', 'cpaneluser_kmf_website'); 
define('DB_USER', 'cpaneluser_kmf_user');    
define('DB_PASS', 'secure_password_from_cpanel_db_wizard'); 
define('DB_CHARSET', 'utf8mb4');

function getDb(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = 'mysql:host=' . DB_HOST . ';dbname=' . DB_NAME . ';charset=' . DB_CHARSET;
        $opts = [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES   => false, // Better security
        ];
        $pdo = new PDO($dsn, DB_USER, DB_PASS, $opts);
    }
    return $pdo;
}
